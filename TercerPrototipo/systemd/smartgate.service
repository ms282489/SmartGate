[Unit]
Description=Sistema de acceso SmartGate

[Service]
Type=simple
WorkingDirectory=%h/Documents/SmartGate/TercerPrototipo
ExecStart=%h/Documents/SmartGate/TercerPrototipo/systemd/iniciar_smartgate.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
TimeoutStartSec=0
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
